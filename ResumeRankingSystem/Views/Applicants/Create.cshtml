@model Domain.Entities.Applicant

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Applicant</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Username and Password Inputs -->
            <div class="form-group">
                <label asp-for="Username" class="control-label"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Hidden fields for other pre-filled data -->
            <input type="hidden" asp-for="FirstName" value="@Model.FirstName" />
            <input type="hidden" asp-for="MiddleName" value="@Model.MiddleName" />
            <input type="hidden" asp-for="LastName" value="@Model.LastName" />
            <input type="hidden" asp-for="Objective" value="@Model.Objective" />
            <input type="hidden" asp-for="Email" value="@Model.Email" />
            <input type="hidden" asp-for="PhoneNumber" value="@Model.PhoneNumber" />
            <input type="hidden" asp-for="Address" value="@Model.Address" />
            <input type="hidden" asp-for="Gender" value="@Model.Gender" />
            <input type="hidden" asp-for="Age" value="@Model.Age" />
            <input type="hidden" asp-for="Experience" value="@Model.Experience" />
            <input type="hidden" asp-for="Education" value="@Model.Education" />
            <input type="hidden" asp-for="Skills" value="@Model.Skills" />

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
