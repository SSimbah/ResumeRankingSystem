@model Domain.Entities.Application

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Details</h1>

<div>
    <h4>Application</h4>
    <hr />
    <dl class="row">
        @* <dt class = "col-sm-2"> *@
        @*     @Html.DisplayNameFor(model => model.JobId) *@
        @* </dt> *@
        @* <dd class = "col-sm-10"> *@
        @*     @Html.DisplayFor(model => model.JobId) *@
        @* </dd> *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Applicant.FullName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Applicant.FullName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            Overall Score
        </dt>
        <dd class = "col-sm-10">
            <td>@($"{Model.Score * 100:F0}%")</td>
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SkillsScoring)
        </dt>
        <dd class="col-sm-10">
            <td>@($"{Model.SkillsScoring * 100:F0}%")</td>
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EducationScoring)
        </dt>
        <dd class="col-sm-10">
            <td>@($"{Model.EducationScoring * 100:F0}%")</td>
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ExperienceScoring)
        </dt>
        <dd class="col-sm-10">
            <td>@($"{Model.ExperienceScoring * 100:F0}%")</td>
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Details" asp-controller="Applicants" asp-route-id="@Model.Applicant.ApplicantId">Applicant Profile</a> |
    <a asp-action="Edit" asp-route-id="@Model?.ApplicationId">Edit</a> |
    <a asp-action="ApplicantRank" asp-route-jobId="@Model?.JobId">Back to Ranking</a>
</div>
