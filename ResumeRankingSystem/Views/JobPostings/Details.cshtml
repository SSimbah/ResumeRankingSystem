@model Domain.Entities.JobPosting

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div>
    <h4>@Html.DisplayFor(model => model.Title)</h4>
    <hr />
    <a asp-action="Index">Back to List</a> <text>|</text>
    @if (ViewBag.LoggedInUserId != null && ViewBag.LoggedInUserId == Model.UserId)
    {
        <a asp-action="Edit" asp-route-id="@Model?.JobId">Edit</a> <text>|</text>
        <a asp-action="Delete" asp-route-id="@Model?.JobId">Delete</a>
    }
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User.Email)
        </dd>
    </dl>
</div>
<div>
    <!-- Bootstrap Flexbox container -->
    <div class="d-flex flex-wrap gap-3 mt-4 align-items-center justify-content-center">
        <!-- Dropdown for Skill, Education, and Experience Requirements -->
        <div class="dropdown">
            <button class="btn btn-dark dropdown-toggle" type="button" id="requirementsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                View Requirements
            </button>
            <ul class="dropdown-menu" aria-labelledby="requirementsDropdown">
                <li>
                    <a class="dropdown-item"
                       asp-action="GetByJobId"
                       asp-controller="SkillRequirements"
                       asp-route-jobId="@Model.JobId">
                        Skill Requirements
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-action="GetByJobId"
                       asp-controller="EducationRequirements"
                       asp-route-jobId="@Model.JobId">
                        Education Requirements
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-action="GetByJobId"
                       asp-controller="ExperienceRequirements"
                       asp-route-jobId="@Model.JobId">
                        Experience Requirements
                    </a>
                </li>
            </ul>
        </div>

        <!-- View Applicant Ranking Button -->
        <a asp-action="ApplicantRank"
           asp-controller="Applications"
           asp-route-jobId="@Model.JobId"
           class="btn btn-dark">
            View Applicant Ranking
        </a>
    </div>
</div>