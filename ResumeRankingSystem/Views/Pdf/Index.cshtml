@{
    ViewData["Title"] = "Upload PDF Form";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">@ViewData["Title"]</h2>


    <div class="form-group">
        <label for="file" class="form-label fw-bold">Download and Fill Up Resume Template:</label>
        <a asp-action="DownloadTemplate" asp-controller="Pdf" class="btn btn-secondary">Resume Template</a>
    </div>

    <form method="post" enctype="multipart/form-data" asp-action="ExtractText" asp-controller="Pdf" class="p-4 border rounded shadow-sm bg-light">
        <div class="form-group mb-3">
            <label for="file" class="form-label fw-bold">Choose PDF file:</label>
            <input type="file"
                   id="file"
                   name="file"
                   accept="application/pdf"
                   class="form-control"
                   required />
        </div>
        <div class="d-grid">
            <button type="submit" class="btn btn-primary">Upload</button>
        </div>
    </form>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info mt-4" role="alert">
            @ViewBag.Message
        </div>
    }
</div>
